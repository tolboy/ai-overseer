#!/usr/bin/env sh
# Exported, not only assigned. Run from inside another repository, Overseer finds
# scripts/visual-qa.mjs through OSEER_HOME; oseer.cmd always passed it on, and this launcher
# let the JVM start without it, so the browser harness was "not found" in every target worktree.
OSEER_HOME="$(cd "$(dirname "$0")/.." && pwd)"
export OSEER_HOME
OSEER_CLASSES="$OSEER_HOME/out/classes"
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) OSEER_CLASSES="$(cygpath -w "$OSEER_CLASSES")" ;;
esac
exec java -cp "$OSEER_CLASSES" dev.oseer.Main "$@"
